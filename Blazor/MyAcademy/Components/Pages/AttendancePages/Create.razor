@page "/attendance/create"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Attendance</h2>
<hr />
<div class="row">
	<div class="col-md-6">
		<EditForm method="post" Model="item" OnValidSubmit="AddAttendance" FormName="create" Enhance>
			<DataAnnotationsValidator />
			<ValidationSummary class="text-danger" role="alert" />
			<div class="mb-3">
				<label for="student" class="form-label">student:</label>
				<InputSelect id="student" @bind-Value="item.student" class="form-select">
					@using (MyAcademy.Data.MyAcademyContext ctx = DbFactory.CreateDbContext())
					{
						@foreach (var o in ctx.Students)
						{
							<option value="@o.stud_id">@o.last_name</option>
						}
					}
				</InputSelect>
				<ValidationMessage For="() => item.student" class="text-danger" />
			</div>
			<div class="mb-3">
				<label for="lesson" class="form-label">lesson:</label>
				<InputSelect id="lesson" @bind-Value="item.lesson" class="form-select">
					@using (MyAcademy.Data.MyAcademyContext ctx = DbFactory.CreateDbContext())
					{
						@foreach (var o in ctx.Schedule)
						{
							<option value="@o.lesson_id">@o.date</option>
						}
					}
				</InputSelect>
				<ValidationMessage For="() => item.lesson" class="text-danger" />
			</div>
			<div class="mb-3">
				<div class="form-check">
					<InputCheckbox id="present" @bind-Value="item.present" class="form-check-input" />
					<label for="present" class="form-check-label">present:</label>
				</div>
				<ValidationMessage For="() => item.present" class="text-danger" />
			</div>
			<button type="submit" class="btn btn-primary">Create</button>
		</EditForm>
	</div>
</div>

<div>
	<a href="/attendance">Back to List</a>
</div>

@code {
	[SupplyParameterFromForm]
	private Attendance item { get; set; } = new();

	private async Task AddAttendance()
	{
		using var context = DbFactory.CreateDbContext();
		context.Attendance.Add(item);
		await context.SaveChangesAsync();
		NavigationManager.NavigateTo("/attendance");
	}
}
