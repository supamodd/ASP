@page "/discipline-directions/create"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>DisciplineDirectionRelation</h2>
<hr />
<div class="row">
	<div class="col-md-6">
		<EditForm method="post" Model="item" OnValidSubmit="AddDisciplineDirectionRelation" FormName="create" Enhance>
			<DataAnnotationsValidator />
			<ValidationSummary class="text-danger" role="alert" />
			<div class="mb-3">
				<label for="direction" class="form-label">direction:</label>
				<InputSelect id="direction" @bind-Value="item.direction" class="form-select">
					@using (MyAcademy.Data.MyAcademyContext ctx = DbFactory.CreateDbContext())
					{
						@foreach (var o in ctx.Directions)
						{
							<option value="@o.direction_id">@o.direction_name</option>
						}
					}
				</InputSelect>
				<ValidationMessage For="() => item.direction" class="text-danger" />
			</div>
			<div class="mb-3">
				<label for="discipline" class="form-label">discipline:</label>
				<InputSelect id="discipline" @bind-Value="item.discipline" class="form-select">
					@using (MyAcademy.Data.MyAcademyContext ctx = DbFactory.CreateDbContext())
					{
						@foreach (var o in ctx.Disciplines)
						{
							<option value="@o.discipline_id">@o.discipline_name</option>
						}
					}
				</InputSelect>
				<ValidationMessage For="() => item.discipline" class="text-danger" />
			</div>
			<button type="submit" class="btn btn-primary">Create</button>
		</EditForm>
	</div>
</div>

<div>
	<a href="/discipline-directions">Back to List</a>
</div>

@code {
	[SupplyParameterFromForm]
	private DisciplineDirectionRelation item { get; set; } = new();

	private async Task AddDisciplineDirectionRelation()
	{
		using var context = DbFactory.CreateDbContext();
		context.DisciplinesDirectionsRelation.Add(item);
		await context.SaveChangesAsync();
		NavigationManager.NavigateTo("/discipline-directions");
	}
}
