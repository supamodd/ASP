@page "/attendance/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>Attendance</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">student</dt>
		<dd class="col-sm-10">@($"{item.Student?.last_name} ({item.student})")</dd>
		<dt class="col-sm-2">lesson</dt>
		<dd class="col-sm-10">@($"{item.Lesson?.date} ({item.lesson})")</dd>
		<dt class="col-sm-2">present</dt>
		<dd class="col-sm-10">@item.present</dd>
	</dl>

	<EditForm method="post" Model="item" OnValidSubmit="DeleteAttendance" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/attendance">Back to List</a>
	</EditForm>
}

@code {
	private Attendance? item;

	[SupplyParameterFromQuery]
	private int student { get; set; } = default!;
	[SupplyParameterFromQuery]
	private long lesson { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.Attendance
			.Include(x => x.Student)
			.Include(x => x.Lesson)
			.Include(x => x.Lesson).ThenInclude(y => y.Group)
			.Include(x => x.Lesson).ThenInclude(y => y.Discipline)
			.FirstOrDefaultAsync(m => m.student == student && m.lesson == lesson);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteAttendance()
	{
		using var context = DbFactory.CreateDbContext();
		context.Attendance.Remove(item!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/attendance/details?student={item.student}&lesson={item.lesson}");
			return;
		}

		NavigationManager.NavigateTo("/attendance");
	}
}
