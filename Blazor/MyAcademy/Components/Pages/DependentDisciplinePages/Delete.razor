@page "/dependent-disciplines/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>DependentDiscipline</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">discipline</dt>
		<dd class="col-sm-10">@($"{item.Discipline?.discipline_name} ({item.discipline})")</dd>
		<dt class="col-sm-2">dependent_discipline</dt>
		<dd class="col-sm-10">@($"{item.Dependent?.discipline_name} ({item.dependent_discipline})")</dd>
	</dl>

	<EditForm method="post" Model="item" OnValidSubmit="DeleteDependentDiscipline" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/dependent-disciplines">Back to List</a>
	</EditForm>
}

@code {
	private DependentDiscipline? item;

	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int dependent_discipline { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.DependentDisciplines
			.Include(x => x.Discipline)
			.Include(x => x.Dependent)
			.FirstOrDefaultAsync(m => m.discipline == discipline && m.dependent_discipline == dependent_discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteDependentDiscipline()
	{
		using var context = DbFactory.CreateDbContext();
		context.DependentDisciplines.Remove(item!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/dependent-disciplines/details?discipline={item.discipline}&dependent_discipline={item.dependent_discipline}");
			return;
		}

		NavigationManager.NavigateTo("/dependent-disciplines");
	}
}
