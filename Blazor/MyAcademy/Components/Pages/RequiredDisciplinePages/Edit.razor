@page "/required-disciplines/edit"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>RequiredDiscipline</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<div class="row">
		<div class="col-md-6">
			<EditForm method="post" Model="item" OnValidSubmit="UpdateRequiredDiscipline" FormName="edit" Enhance>
				<DataAnnotationsValidator />
				<ValidationSummary class="text-danger" role="alert" />
				<input type="hidden" name="item.discipline" value="@item.discipline" />
				<input type="hidden" name="item.required_discipline" value="@item.required_discipline" />

				<button type="submit" class="btn btn-primary">Save</button>
			</EditForm>
		</div>
	</div>
}

<div>
	<a href="/required-disciplines">Back to List</a>
</div>

@code {
	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int required_discipline { get; set; } = default!;

	[SupplyParameterFromForm]
	private RequiredDiscipline? item { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.RequiredDisciplines
			.Include(x => x.Discipline)
			.Include(x => x.Required)
			.FirstOrDefaultAsync(m => m.discipline == discipline && m.required_discipline == required_discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task UpdateRequiredDiscipline()
	{
		using var context = DbFactory.CreateDbContext();
		context.Attach(item!).State = EntityState.Modified;

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateConcurrencyException)
		{
			if (!RequiredDisciplineExists())
			{
				NavigationManager.NavigateTo("notfound");
			}
			else
			{
				throw;
			}
		}

		NavigationManager.NavigateTo("/required-disciplines");
	}

	private bool RequiredDisciplineExists()
	{
		using var context = DbFactory.CreateDbContext();
		return context.RequiredDisciplines.Any(e => e.discipline == discipline && e.required_discipline == required_discipline);
	}
}
