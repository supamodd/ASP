@page "/discipline-directions"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Disciplines - Directions</PageTitle>

<h1>Disciplines - Directions</h1>

<div class="controls">
	<p>
		<a href="discipline-directions/create" class="btn btn-primary">Create New</a>
	</p>
	<form action="/discipline-directions" class="search-form">
		<input type="search" name="nameFilter" value="@NameFilter" placeholder="Search by Direction, Discipline" />
		<input type="submit" value="Search" class="btn btn-primary" />
		<a href="discipline-directions" class="btn btn-secondary">Reset</a>
	</form>
	<div>
		<label for="items-per-page">Rows: </label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="13">13</option>
		</select>
	</div>
</div>

<div class="filters">
	<span class="filter-title">Filters:</span>
		<label class="filter-item">direction:
			<select @bind="directionFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Directions)
				{
					<option value="@o.direction_id">@o.direction_name</option>
				}
			</select>
		</label>
		<label class="filter-item">discipline:
			<select @bind="disciplineFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Disciplines)
				{
					<option value="@o.discipline_id">@o.discipline_name</option>
				}
			</select>
		</label>
	<a href="discipline-directions" class="btn btn-secondary btn-sm">Reset</a>
</div>

<div class="grid-container">
	<QuickGrid Class="table" Items="FilteredDisciplinesDirectionsRelation" Pagination="pagination">
		<TemplateColumn Context="item" Title="direction" Sortable="true" SortBy="@SortByDirection">
			<span>@item.Direction?.direction_name</span>
		</TemplateColumn>
		<TemplateColumn Context="item" Title="discipline" Sortable="true" SortBy="@SortByDiscipline">
			<span>@item.Discipline?.discipline_name</span>
		</TemplateColumn>
		<TemplateColumn Context="item" Title="actions">
			<a href="@($"discipline-directions/edit?direction={item.direction}&discipline={item.discipline}")">Edit</a> |
			<a href="@($"discipline-directions/details?direction={item.direction}&discipline={item.discipline}")">Details</a> |
			<a href="@($"discipline-directions/delete?direction={item.direction}&discipline={item.discipline}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

<Paginator State="pagination" />

@code {
	private MyAcademyContext context = default!;
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	// Поисковая строка приходит из адреса страницы: /discipline-directions?nameFilter=...
	[SupplyParameterFromQuery]
	string? NameFilter { get; set; }

	// Пустой фильтр = показываем все записи.
	// Регистр не важен: на SQL Server сравнение идёт по сортировке БД (CI).
	private string Filter => NameFilter ?? string.Empty;

	private int directionFilter { get; set; }
	private int disciplineFilter { get; set; }

	IQueryable<DisciplineDirectionRelation> FilteredDisciplinesDirectionsRelation =>
		BuildQuery();

	private IQueryable<DisciplineDirectionRelation> BuildQuery()
	{
		IQueryable<DisciplineDirectionRelation> q = context.DisciplinesDirectionsRelation
			.Include(x => x.Direction)
			.Include(x => x.Discipline);

		var f = Filter;
		if (!string.IsNullOrEmpty(f))
		{
			q = q.Where(x =>
				x.Direction != null && (x.Direction.direction_name ?? string.Empty).Contains(f) ||
				x.Discipline != null && (x.Discipline.discipline_name ?? string.Empty).Contains(f));
		}

		if (directionFilter != 0)
		{
			q = q.Where(x => x.direction == directionFilter);
		}

		if (disciplineFilter != 0)
		{
			q = q.Where(x => x.discipline == disciplineFilter);
		}

		return q;
	}

	// Сортировка по связанным полям: TemplateColumn не поддерживает Property,
	// поэтому передаём GridSort.ByAscending(...)
	private GridSort<DisciplineDirectionRelation> SortByDirection { get; } =
		GridSort<DisciplineDirectionRelation>.ByAscending(x => x.Direction!.direction_name);

	private GridSort<DisciplineDirectionRelation> SortByDiscipline { get; } =
		GridSort<DisciplineDirectionRelation>.ByAscending(x => x.Discipline!.discipline_name);

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
