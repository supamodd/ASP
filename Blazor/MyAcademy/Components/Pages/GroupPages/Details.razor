@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<h2>Group</h2>
<hr />
@if (group is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">group_id</dt>
		<dd class="col-sm-10">@group.group_id</dd>
		<dt class="col-sm-2">group_name</dt>
		<dd class="col-sm-10">@group.group_name</dd>
		<dt class="col-sm-2">direction</dt>
		<dd class="col-sm-10">@group.Direction?.direction_name</dd>
		<dt class="col-sm-2">weekdays</dt>
		<dd class="col-sm-10">@Week.Decode(group.weekdays)</dd>
		<dt class="col-sm-2">start_time</dt>
		<dd class="col-sm-10">@group.start_time</dd>
		<dt class="col-sm-2">start_date</dt>
		<dd class="col-sm-10">@group.start_date</dd>
	</dl>

	<h3>Students <span class="count">(@group.Students.Count)</span></h3>
	@if (group.Students.Count == 0)
	{
		<p><em>В этой группе пока нет студентов.</em></p>
	}
	else
	{
		<table class="table related-table">
			<thead>
				<tr>
					<th>stud_id</th>
					<th>last_name</th>
					<th>first_name</th>
					<th>middle_name</th>
					<th>birth_date</th>
					<th>email</th>
					<th>phone</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var student in group.Students)
				{
					<tr>
						<td>@student.stud_id</td>
						<td>@student.last_name</td>
						<td>@student.first_name</td>
						<td>@student.middle_name</td>
						<td>@student.birth_date</td>
						<td>@student.email</td>
						<td>@student.phone</td>
						<td><a href="@($"/students/details?stud_id={student.stud_id}")">Details</a></td>
					</tr>
				}
			</tbody>
		</table>
	}
}

<div>
	<a href="@($"/groups/edit?group_id={group?.group_id}")">Edit</a> |
	<a href="/groups">Back to List</a>
</div>

@code {
	private Group? group;

	[SupplyParameterFromQuery]
	private int group_id { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		// Вместе с группой подтягиваем её направление и список студентов этой группы.
		// AsSplitQuery - коллекция студентов грузится отдельным запросом, без дублирования строк группы.
		group = await context.Groups
			.Include(g => g.Direction)
			.Include(g => g.Students.OrderBy(s => s.last_name).ThenBy(s => s.first_name))
			.AsSplitQuery()
			.AsNoTracking()
			.FirstOrDefaultAsync(m => m.group_id == group_id);

		if (group is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}
}
