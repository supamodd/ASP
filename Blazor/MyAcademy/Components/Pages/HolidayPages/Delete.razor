@page "/holidays/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>Holiday</h2>
<hr />
@if (holiday is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">holiday_id</dt>
		<dd class="col-sm-10">@holiday.holiday_id</dd>
		<dt class="col-sm-2">holiday_name</dt>
		<dd class="col-sm-10">@holiday.holiday_name</dd>
		<dt class="col-sm-2">duration</dt>
		<dd class="col-sm-10">@holiday.duration</dd>
		<dt class="col-sm-2">month</dt>
		<dd class="col-sm-10">@holiday.month</dd>
		<dt class="col-sm-2">day</dt>
		<dd class="col-sm-10">@holiday.day</dd>
	</dl>

	<EditForm method="post" Model="holiday" OnValidSubmit="DeleteHoliday" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/holidays">Back to List</a>
	</EditForm>
}

@code {
	private Holiday? holiday;

	[SupplyParameterFromQuery]
	private int holiday_id { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		holiday ??= await context.Holidays
			.FirstOrDefaultAsync(m => m.holiday_id == holiday_id);

		if (holiday is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteHoliday()
	{
		using var context = DbFactory.CreateDbContext();
		context.Holidays.Remove(holiday!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/holidays/details?holiday_id={holiday.holiday_id}");
			return;
		}

		NavigationManager.NavigateTo("/holidays");
	}
}
