@page "/required-disciplines/create"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>RequiredDiscipline</h2>
<hr />
<div class="row">
	<div class="col-md-6">
		<EditForm method="post" Model="item" OnValidSubmit="AddRequiredDiscipline" FormName="create" Enhance>
			<DataAnnotationsValidator />
			<ValidationSummary class="text-danger" role="alert" />
			<div class="mb-3">
				<label for="discipline" class="form-label">discipline:</label>
				<InputSelect id="discipline" @bind-Value="item.discipline" class="form-select">
					@using (MyAcademy.Data.MyAcademyContext ctx = DbFactory.CreateDbContext())
					{
						@foreach (var o in ctx.Disciplines)
						{
							<option value="@o.discipline_id">@o.discipline_name</option>
						}
					}
				</InputSelect>
				<ValidationMessage For="() => item.discipline" class="text-danger" />
			</div>
			<div class="mb-3">
				<label for="required_discipline" class="form-label">required_discipline:</label>
				<InputSelect id="required_discipline" @bind-Value="item.required_discipline" class="form-select">
					@using (MyAcademy.Data.MyAcademyContext ctx = DbFactory.CreateDbContext())
					{
						@foreach (var o in ctx.Disciplines)
						{
							<option value="@o.discipline_id">@o.discipline_name</option>
						}
					}
				</InputSelect>
				<ValidationMessage For="() => item.required_discipline" class="text-danger" />
			</div>
			<button type="submit" class="btn btn-primary">Create</button>
		</EditForm>
	</div>
</div>

<div>
	<a href="/required-disciplines">Back to List</a>
</div>

@code {
	[SupplyParameterFromForm]
	private RequiredDiscipline item { get; set; } = new();

	private async Task AddRequiredDiscipline()
	{
		using var context = DbFactory.CreateDbContext();
		context.RequiredDisciplines.Add(item);
		await context.SaveChangesAsync();
		NavigationManager.NavigateTo("/required-disciplines");
	}
}
