@page "/teachers/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<h2>Teacher</h2>
<hr />
@if (teacher is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">teacher_id</dt>
		<dd class="col-sm-10">@teacher.teacher_id</dd>
		<dt class="col-sm-2">last_name</dt>
		<dd class="col-sm-10">@teacher.last_name</dd>
		<dt class="col-sm-2">first_name</dt>
		<dd class="col-sm-10">@teacher.first_name</dd>
		<dt class="col-sm-2">middle_name</dt>
		<dd class="col-sm-10">@teacher.middle_name</dd>
		<dt class="col-sm-2">birth_date</dt>
		<dd class="col-sm-10">@teacher.birth_date</dd>
		<dt class="col-sm-2">email</dt>
		<dd class="col-sm-10">@teacher.email</dd>
		<dt class="col-sm-2">phone</dt>
		<dd class="col-sm-10">@teacher.phone</dd>
		<dt class="col-sm-2">work_since</dt>
		<dd class="col-sm-10">@teacher.work_since</dd>
		<dt class="col-sm-2">rate</dt>
		<dd class="col-sm-10">@teacher.rate</dd>
	</dl>
	<div class="photo-block">
		@if (teacher.photo is not null && teacher.photo.Length > 0)
		{
			<img class="photo-preview" src="data:image/*;base64,@Convert.ToBase64String(teacher.photo!)" alt="photo" />
		}
		else
		{
			<div class="photo-empty">no photo</div>
		}
	</div>

	<h3>Disciplines <span class="count">(@disciplines.Count)</span></h3>
	@if (disciplines.Count == 0)
	{
		<p><em>Преподаватель пока не ведёт ни одной дисциплины.</em></p>
	}
	else
	{
		<table class="table related-table">
			<thead>
				<tr>
					<th>discipline_id</th>
					<th>discipline_name</th>
					<th>number_of_lessons</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var discipline in disciplines)
				{
					<tr>
						<td>@discipline.discipline_id</td>
						<td>@discipline.discipline_name</td>
						<td>@discipline.number_of_lessons</td>
						<td><a href="@($"/disciplines/details?discipline_id={discipline.discipline_id}")">Details</a></td>
					</tr>
				}
			</tbody>
		</table>
	}
}

<div>
	<a href="@($"/teachers/edit?teacher_id={teacher?.teacher_id}")">Edit</a> |
	<a href="/teachers">Back to List</a>
</div>

@code {
	private Teacher? teacher;

	// Дисциплины, которые ведёт преподаватель (связь многие-ко-многим через TeachersDisciplinesRelation).
	private List<Discipline> disciplines = new();

	[SupplyParameterFromQuery]
	private int teacher_id { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		teacher = await context.Teachers.AsNoTracking().FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

		if (teacher is null)
		{
			NavigationManager.NavigateTo("notfound");
			return;
		}

		// Идём по связи: teacher -> TeachersDisciplinesRelation -> Discipline
		disciplines = await context.TeachersDisciplinesRelation
			.AsNoTracking()
			.Where(r => r.teacher == teacher_id)
			.Select(r => r.Discipline!)
			.OrderBy(d => d.discipline_name)
			.ToListAsync();
	}
}
