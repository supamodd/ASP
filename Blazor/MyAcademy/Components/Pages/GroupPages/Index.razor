@page "/groups"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Groups</PageTitle>

<h1>Groups</h1>

<div class="controls">
	<p>
		<a href="groups/create" class="btn btn-primary">Create New</a>
	</p>
	<form action="/groups" class="search-form">
		<input type="search" name="nameFilter" value="@NameFilter" placeholder="Search by group or direction" />
		<input type="submit" value="Search" class="btn btn-primary" />
		<a href="groups" class="btn btn-secondary">Reset</a>
	</form>
	<div>
		<label for="items-per-page">Rows: </label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="13">13</option>
		</select>
	</div>
</div>

<div class="grid-container">
	<QuickGrid Class="table" Items="FilteredGroups" Pagination="pagination">
		<PropertyColumn Property="group => group.group_id" Sortable="true" />
		<PropertyColumn Property="group => group.group_name" Sortable="true" Class="title" />
		<TemplateColumn Context="group" Title="direction" Sortable="true" SortBy="@SortByDirection">
			<span>@group.Direction?.direction_name</span>
		</TemplateColumn>
		<PropertyColumn Property="group => group.start_date" Sortable="true" />
		<PropertyColumn Property="group => group.start_time" Sortable="true" />
		<TemplateColumn Context="group" Title="weekdays" Sortable="true" SortBy="@SortByWeekdays">
			<span>@Week.Decode(group.weekdays)</span>
		</TemplateColumn>
		<TemplateColumn Context="group" Title="actions">
			<a href="@($"groups/edit?group_id={group.group_id}")">Edit</a> |
			<a href="@($"groups/details?group_id={group.group_id}")">Details</a> |
			<a href="@($"groups/delete?group_id={group.group_id}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

<Paginator State="pagination" />

@code {
	private MyAcademyContext context = default!;
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	// Поисковая строка приходит из адреса страницы: /groups?nameFilter=...
	[SupplyParameterFromQuery]
	string? NameFilter { get; set; }

	// Пустой фильтр = показываем все записи.
	// Регистр не важен: на SQL Server сравнение идёт по сортировке БД (CI).
	private string Filter => NameFilter ?? string.Empty;

	IQueryable<Group> FilteredGroups =>
		context.Groups.Include(g => g.Direction).Where(g =>
			g.group_name.Contains(Filter) ||
			(g.Direction != null && (g.Direction.direction_name ?? string.Empty).Contains(Filter)));


	// Сортировка по связанным и вычисляемым полям:
	// TemplateColumn не поддерживает Property, поэтому передаём GridSort.ByAscending(...)
	private GridSort<Group> SortByDirection { get; } =
		GridSort<Group>.ByAscending(g => g.Direction!.direction_name);

	private GridSort<Group> SortByWeekdays { get; } =
		GridSort<Group>.ByAscending(g => g.weekdays);

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
