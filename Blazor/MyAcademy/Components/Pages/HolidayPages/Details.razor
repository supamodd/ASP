@page "/holidays/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<h2>Holiday</h2>
<hr />
@if (holiday is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">holiday_id</dt>
		<dd class="col-sm-10">@holiday.holiday_id</dd>
		<dt class="col-sm-2">holiday_name</dt>
		<dd class="col-sm-10">@holiday.holiday_name</dd>
		<dt class="col-sm-2">duration</dt>
		<dd class="col-sm-10">@holiday.duration</dd>
		<dt class="col-sm-2">month</dt>
		<dd class="col-sm-10">@holiday.month</dd>
		<dt class="col-sm-2">day</dt>
		<dd class="col-sm-10">@holiday.day</dd>
	</dl>

}

<div>
	<a href="@($"/holidays/edit?holiday_id={holiday.holiday_id}")">Edit</a> |
	<a href="/holidays">Back to List</a>
</div>

@code {
	private Holiday? holiday;

	[SupplyParameterFromQuery]
	private int holiday_id { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		holiday ??= await context.Holidays
			.FirstOrDefaultAsync(m => m.holiday_id == holiday_id);

		if (holiday is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}
}
