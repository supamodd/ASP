@page "/movies/edit"
@using Microsoft.EntityFrameworkCore
@using Movies.Models
@inject IDbContextFactory<Movies.Data.MoviesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Movie</h2>
<hr />
@if (Movie is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="movie-container">
        <div class="movie-details">
            <div class="row">
                <div class="col-md-8">
                    <EditForm method="post" Model="Movie" OnValidSubmit="UpdateMovie" FormName="edit" Enhance>
                        <DataAnnotationsValidator />
                        <ValidationSummary role="alert" />
                        <input type="hidden" name="Movie.Id" value="@Movie.Id" />
                        <div class="mb-3">
                            <label for="title" class="form-label">Title:</label>
                            <InputText id="title" @bind-Value="Movie.Title" class="form-control" />
                            <ValidationMessage For="() => Movie.Title" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label for="releasedate" class="form-label">ReleaseDate:</label>
                            <InputDate id="releasedate" @bind-Value="Movie.ReleaseDate" class="form-control" />
                            <ValidationMessage For="() => Movie.ReleaseDate" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label for="genre" class="form-label">Genre:</label>
                            <InputText id="genre" @bind-Value="Movie.Genre" class="form-control" />
                            <ValidationMessage For="() => Movie.Genre" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label for="url" class="form-label">URL:</label>
                            <InputText id="url" @bind-Value="Movie.URL" class="form-control" />
                            <ValidationMessage For="() => Movie.URL" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label for="poster" class="form-label">Poster (URL картинки):</label>
                            @* oninput — чтобы предпросмотр обновлялся прямо во время ввода ссылки *@
                            <InputText id="poster" @bind-Value="Movie.Poster" @bind-Value:event="oninput"
                                       class="form-control" placeholder="https://example.com/poster.jpg" />
                            <ValidationMessage For="() => Movie.Poster" class="text-danger" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </EditForm>
                </div>
            </div>
        </div>

        @* Предпросмотр постера *@
        <div class="movie-poster">
            <div class="poster-caption">Poster</div>
            @if (string.IsNullOrWhiteSpace(Movie.Poster))
            {
                <div class="poster-placeholder">Постер не задан</div>
            }
            else if (PosterIsBroken)
            {
                <div class="poster-placeholder">
                    Постер не загрузился.<br />Проверьте ссылку выше.
                </div>
            }
            else
            {
                <img src="@Movie.Poster" alt="Poster: @Movie.Title" @onerror="OnPosterError" />
            }
        </div>
    </div>
}

<div>
    <a href="/movies">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Movie? Movie { get; set; }

    // Ссылка на постер, которую браузер не смог загрузить (null — всё в порядке)
    private string? _brokenPoster;

    // Сломанной считается только та ссылка, на которой реально случилась ошибка:
    // как только URL в поле меняется, постер снова пробует загрузиться.
    private bool PosterIsBroken =>
        !string.IsNullOrWhiteSpace(Movie?.Poster) && _brokenPoster == Movie.Poster;

    private void OnPosterError() => _brokenPoster = Movie?.Poster;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Movie ??= await context.Movie.FirstOrDefaultAsync(m => m.Id == Id);

        if (Movie is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateMovie()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Movie!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!MovieExists(Movie!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/movies");
    }

    private bool MovieExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Movie.Any(e => e.Id == id);
    }
}
