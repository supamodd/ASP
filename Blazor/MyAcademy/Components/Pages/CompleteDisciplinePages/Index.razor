@page "/complete-disciplines"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Complete Disciplines</PageTitle>

<h1>Complete Disciplines</h1>

<div class="controls">
	<p>
		<a href="complete-disciplines/create" class="btn btn-primary">Create New</a>
	</p>
	<form action="/complete-disciplines" class="search-form">
		<input type="search" name="nameFilter" value="@NameFilter" placeholder="Search by Group, Discipline" />
		<input type="submit" value="Search" class="btn btn-primary" />
		<a href="complete-disciplines" class="btn btn-secondary">Reset</a>
	</form>
	<div>
		<label for="items-per-page">Rows: </label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="13">13</option>
		</select>
	</div>
</div>

<div class="filters">
	<span class="filter-title">Filters:</span>
		<label class="filter-item">group:
			<select @bind="groupFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Groups)
				{
					<option value="@o.group_id">@o.group_name</option>
				}
			</select>
		</label>
		<label class="filter-item">discipline:
			<select @bind="disciplineFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Disciplines)
				{
					<option value="@o.discipline_id">@o.discipline_name</option>
				}
			</select>
		</label>
	<a href="complete-disciplines" class="btn btn-secondary btn-sm">Reset</a>
</div>

<div class="grid-container">
	<QuickGrid Class="table" Items="FilteredCompleteDisciplines" Pagination="pagination">
		<TemplateColumn Context="item" Title="group" Sortable="true" SortBy="@SortByGroup">
			<span>@item.Group?.group_name</span>
		</TemplateColumn>
		<TemplateColumn Context="item" Title="discipline" Sortable="true" SortBy="@SortByDiscipline">
			<span>@item.Discipline?.discipline_name</span>
		</TemplateColumn>
		<TemplateColumn Context="item" Title="actions">
			<a href="@($"complete-disciplines/edit?group={item.group}&discipline={item.discipline}")">Edit</a> |
			<a href="@($"complete-disciplines/details?group={item.group}&discipline={item.discipline}")">Details</a> |
			<a href="@($"complete-disciplines/delete?group={item.group}&discipline={item.discipline}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

<Paginator State="pagination" />

@code {
	private MyAcademyContext context = default!;
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	// Поисковая строка приходит из адреса страницы: /complete-disciplines?nameFilter=...
	[SupplyParameterFromQuery]
	string? NameFilter { get; set; }

	// Пустой фильтр = показываем все записи.
	// Регистр не важен: на SQL Server сравнение идёт по сортировке БД (CI).
	private string Filter => NameFilter ?? string.Empty;

	private int groupFilter { get; set; }
	private int disciplineFilter { get; set; }

	IQueryable<CompleteDiscipline> FilteredCompleteDisciplines =>
		BuildQuery();

	private IQueryable<CompleteDiscipline> BuildQuery()
	{
		IQueryable<CompleteDiscipline> q = context.CompleteDisciplines
			.Include(x => x.Group)
			.Include(x => x.Discipline);

		var f = Filter;
		if (!string.IsNullOrEmpty(f))
		{
			q = q.Where(x =>
				x.Group != null && x.Group.group_name.Contains(f) ||
				x.Discipline != null && (x.Discipline.discipline_name ?? string.Empty).Contains(f));
		}

		if (groupFilter != 0)
		{
			q = q.Where(x => x.group == groupFilter);
		}

		if (disciplineFilter != 0)
		{
			q = q.Where(x => x.discipline == disciplineFilter);
		}

		return q;
	}

	// Сортировка по связанным полям: TemplateColumn не поддерживает Property,
	// поэтому передаём GridSort.ByAscending(...)
	private GridSort<CompleteDiscipline> SortByGroup { get; } =
		GridSort<CompleteDiscipline>.ByAscending(x => x.Group!.group_name);

	private GridSort<CompleteDiscipline> SortByDiscipline { get; } =
		GridSort<CompleteDiscipline>.ByAscending(x => x.Discipline!.discipline_name);

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
