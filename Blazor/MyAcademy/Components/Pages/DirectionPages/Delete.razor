@page "/directions/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>Direction</h2>
<hr />
@if (direction is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">direction_id</dt>
		<dd class="col-sm-10">@direction.direction_id</dd>
		<dt class="col-sm-2">direction_name</dt>
		<dd class="col-sm-10">@direction.direction_name</dd>
	</dl>

	<EditForm method="post" Model="direction" OnValidSubmit="DeleteDirection" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/directions">Back to List</a>
	</EditForm>
}

@code {
	private Direction? direction;

	[SupplyParameterFromQuery]
	private int direction_id { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == direction_id);

		if (direction is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteDirection()
	{
		using var context = DbFactory.CreateDbContext();
		context.Directions.Remove(direction!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/directions/details?direction_id={direction!.direction_id}");
			return;
		}

		NavigationManager.NavigateTo("/directions");
	}
}
