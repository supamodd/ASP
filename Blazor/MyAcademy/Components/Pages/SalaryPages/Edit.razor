@page "/salary/edit"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Salary</h2>
<hr />
@if (payment is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<div class="row">
		<div class="col-md-6">
			<EditForm method="post" Model="payment" OnValidSubmit="UpdateSalary" FormName="edit" Enhance>
				<DataAnnotationsValidator />
				<ValidationSummary class="text-danger" role="alert" />
				<input type="hidden" name="payment.payment_id" value="@payment.payment_id" />
			<div class="mb-3">
				<label for="teacher" class="form-label">teacher:</label>
				<InputSelect id="teacher" @bind-Value="payment.teacher" class="form-select">
					@using (MyAcademy.Data.MyAcademyContext ctx = DbFactory.CreateDbContext())
					{
						@foreach (var o in ctx.Teachers)
						{
							<option value="@o.teacher_id">@o.last_name</option>
						}
					}
				</InputSelect>
				<ValidationMessage For="() => payment.teacher" class="text-danger" />
			</div>
			<div class="mb-3">
				<label for="accrued" class="form-label">accrued:</label>
				<InputNumber id="accrued" @bind-Value="payment.accrued" class="form-control" />
				<ValidationMessage For="() => payment.accrued" class="text-danger" />
			</div>
			<div class="mb-3">
				<div class="form-check">
					<InputCheckbox id="received" @bind-Value="payment.received" class="form-check-input" />
					<label for="received" class="form-check-label">received:</label>
				</div>
				<ValidationMessage For="() => payment.received" class="text-danger" />
			</div>
				<button type="submit" class="btn btn-primary">Save</button>
			</EditForm>
		</div>
	</div>
}

<div>
	<a href="/salary">Back to List</a>
</div>

@code {
	[SupplyParameterFromQuery]
	private long payment_id { get; set; } = default!;

	[SupplyParameterFromForm]
	private Salary? payment { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		payment ??= await context.Salary
			.Include(x => x.Teacher)
			.FirstOrDefaultAsync(m => m.payment_id == payment_id);

		if (payment is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task UpdateSalary()
	{
		using var context = DbFactory.CreateDbContext();
		context.Attach(payment!).State = EntityState.Modified;

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateConcurrencyException)
		{
			if (!SalaryExists())
			{
				NavigationManager.NavigateTo("notfound");
			}
			else
			{
				throw;
			}
		}

		NavigationManager.NavigateTo("/salary");
	}

	private bool SalaryExists()
	{
		using var context = DbFactory.CreateDbContext();
		return context.Salary.Any(e => e.payment_id == payment_id);
	}
}
