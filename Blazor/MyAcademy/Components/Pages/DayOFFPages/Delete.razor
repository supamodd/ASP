@page "/daysoff/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>DayOFF</h2>
<hr />
@if (day is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">date</dt>
		<dd class="col-sm-10">@day.date</dd>
		<dt class="col-sm-2">holiday</dt>
		<dd class="col-sm-10">@($"{day.Holiday?.holiday_name} ({day.holiday})")</dd>
	</dl>

	<EditForm method="post" Model="day" OnValidSubmit="DeleteDayOFF" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/daysoff">Back to List</a>
	</EditForm>
}

@code {
	private DayOFF? day;

	[SupplyParameterFromQuery]
	private DateOnly date { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int holiday { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		day ??= await context.DaysOFF
			.Include(x => x.Holiday)
			.FirstOrDefaultAsync(m => m.date == date && m.holiday == holiday);

		if (day is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteDayOFF()
	{
		using var context = DbFactory.CreateDbContext();
		context.DaysOFF.Remove(day!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/daysoff/details?date={day.date}&holiday={day.holiday}");
			return;
		}

		NavigationManager.NavigateTo("/daysoff");
	}
}
