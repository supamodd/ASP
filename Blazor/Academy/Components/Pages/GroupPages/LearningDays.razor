<h3>LearningDays</h3>

<ul>
	@for (int i = 0; i < 7; i++)
	{
		<li>
			<input type="checkbox" id="@Week.DAYNAMES[i]" @bind="days[i]" />
			<label for="@Week.DAYNAMES[i]">@Week.DAYNAMES[i]</label>
		</li>
	}
</ul>

@code
{
	bool[] days = new bool[7];

	[Parameter]
	public Models.Group Group { get; set; }
	void Extract()
	{
		int mask = Group.learning_days ?? 0;
		for (int i = 0; i < 7; i++)
		{
			if ((mask >> i & 1) != 0) days[i] = true;
		}
	}
	protected override void OnInitialized()
	{
		Extract();
	}
}
