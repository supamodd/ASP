@page "/teachers"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Teachers</PageTitle>

<h1>Teachers</h1>

<div class="controls">
	<p>
		<a href="teachers/create" class="btn btn-primary">Create New</a>
	</p>
	<form action="/teachers" class="search-form">
		<input type="search" name="nameFilter" value="@NameFilter" placeholder="Search by name" />
		<input type="submit" value="Search" class="btn btn-primary" />
		<a href="teachers" class="btn btn-secondary">Reset</a>
	</form>
	<div>
		<label for="items-per-page">Rows: </label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="13">13</option>
		</select>
	</div>
</div>

<div class="grid-container">
	<QuickGrid Class="table" Items="FilteredTeachers" Pagination="pagination">
		<PropertyColumn Property="teacher => teacher.teacher_id" Sortable="true" />
		<PropertyColumn Property="teacher => teacher.last_name" Sortable="true" Class="title" />
		<PropertyColumn Property="teacher => teacher.first_name" Sortable="true" />
		<PropertyColumn Property="teacher => teacher.middle_name" Sortable="true" />
		<PropertyColumn Property="teacher => teacher.birth_date" Sortable="true" />
		<PropertyColumn Property="teacher => teacher.work_since" Sortable="true" />
		<PropertyColumn Property="teacher => teacher.rate" Sortable="true" />
		<TemplateColumn Context="teacher" Title="actions">
			<a href="@($"teachers/edit?teacher_id={teacher.teacher_id}")">Edit</a> |
			<a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">Details</a> |
			<a href="@($"teachers/delete?teacher_id={teacher.teacher_id}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

<Paginator State="pagination" />

@code {
	private MyAcademyContext context = default!;
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	// Поисковая строка приходит из адреса страницы: /teachers?nameFilter=...
	[SupplyParameterFromQuery]
	string? NameFilter { get; set; }

	// Пустой фильтр = показываем все записи.
	// Регистр не важен: на SQL Server сравнение идёт по сортировке БД (CI).
	private string Filter => NameFilter ?? string.Empty;

	IQueryable<Teacher> FilteredTeachers =>
		context.Teachers.Where(t =>
			t.last_name.Contains(Filter) ||
			(t.first_name ?? string.Empty).Contains(Filter) ||
			(t.middle_name ?? string.Empty).Contains(Filter));


	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
