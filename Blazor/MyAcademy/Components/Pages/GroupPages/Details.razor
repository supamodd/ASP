@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<h2>Group</h2>
<hr />
@if (group is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">group_id</dt>
		<dd class="col-sm-10">@group.group_id</dd>
		<dt class="col-sm-2">group_name</dt>
		<dd class="col-sm-10">@group.group_name</dd>
		<dt class="col-sm-2">direction</dt>
		<dd class="col-sm-10">@group.Direction?.direction_name</dd>
		<dt class="col-sm-2">learning_days</dt>
		<dd class="col-sm-10">@Week.Decode(group.learning_days)</dd>
		<dt class="col-sm-2">start_time</dt>
		<dd class="col-sm-10">@group.start_time</dd>
	</dl>

}

<div>
	<a href="@($"/groups/edit?group_id={group?.group_id}")">Edit</a> |
	<a href="/groups">Back to List</a>
</div>

@code {
	private Group? group;

	[SupplyParameterFromQuery]
	private int group_id { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		group = await context.Groups.Include(g => g.Direction).FirstOrDefaultAsync(m => m.group_id == group_id);

		if (group is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}
}
