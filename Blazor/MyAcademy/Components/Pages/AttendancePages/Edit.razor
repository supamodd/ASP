@page "/attendance/edit"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Attendance</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<div class="row">
		<div class="col-md-6">
			<EditForm method="post" Model="item" OnValidSubmit="UpdateAttendance" FormName="edit" Enhance>
				<DataAnnotationsValidator />
				<ValidationSummary class="text-danger" role="alert" />
				<input type="hidden" name="item.student" value="@item.student" />
				<input type="hidden" name="item.lesson" value="@item.lesson" />
			<div class="mb-3">
				<div class="form-check">
					<InputCheckbox id="present" @bind-Value="item.present" class="form-check-input" />
					<label for="present" class="form-check-label">present:</label>
				</div>
				<ValidationMessage For="() => item.present" class="text-danger" />
			</div>
				<button type="submit" class="btn btn-primary">Save</button>
			</EditForm>
		</div>
	</div>
}

<div>
	<a href="/attendance">Back to List</a>
</div>

@code {
	[SupplyParameterFromQuery]
	private int student { get; set; } = default!;
	[SupplyParameterFromQuery]
	private long lesson { get; set; } = default!;

	[SupplyParameterFromForm]
	private Attendance? item { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.Attendance
			.Include(x => x.Student)
			.Include(x => x.Lesson)
			.Include(x => x.Lesson).ThenInclude(y => y.Group)
			.Include(x => x.Lesson).ThenInclude(y => y.Discipline)
			.FirstOrDefaultAsync(m => m.student == student && m.lesson == lesson);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task UpdateAttendance()
	{
		using var context = DbFactory.CreateDbContext();
		context.Attach(item!).State = EntityState.Modified;

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateConcurrencyException)
		{
			if (!AttendanceExists())
			{
				NavigationManager.NavigateTo("notfound");
			}
			else
			{
				throw;
			}
		}

		NavigationManager.NavigateTo("/attendance");
	}

	private bool AttendanceExists()
	{
		using var context = DbFactory.CreateDbContext();
		return context.Attendance.Any(e => e.student == student && e.lesson == lesson);
	}
}
