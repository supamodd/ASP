@page "/discipline-directions/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>DisciplineDirectionRelation</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">direction</dt>
		<dd class="col-sm-10">@($"{item.Direction?.direction_name} ({item.direction})")</dd>
		<dt class="col-sm-2">discipline</dt>
		<dd class="col-sm-10">@($"{item.Discipline?.discipline_name} ({item.discipline})")</dd>
	</dl>

	<EditForm method="post" Model="item" OnValidSubmit="DeleteDisciplineDirectionRelation" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/discipline-directions">Back to List</a>
	</EditForm>
}

@code {
	private DisciplineDirectionRelation? item;

	[SupplyParameterFromQuery]
	private int direction { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.DisciplinesDirectionsRelation
			.Include(x => x.Direction)
			.Include(x => x.Discipline)
			.FirstOrDefaultAsync(m => m.direction == direction && m.discipline == discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteDisciplineDirectionRelation()
	{
		using var context = DbFactory.CreateDbContext();
		context.DisciplinesDirectionsRelation.Remove(item!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/discipline-directions/details?direction={item.direction}&discipline={item.discipline}");
			return;
		}

		NavigationManager.NavigateTo("/discipline-directions");
	}
}
