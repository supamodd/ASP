@page "/teacher-disciplines/edit"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>TeacherDisciplineRelation</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<div class="row">
		<div class="col-md-6">
			<EditForm method="post" Model="item" OnValidSubmit="UpdateTeacherDisciplineRelation" FormName="edit" Enhance>
				<DataAnnotationsValidator />
				<ValidationSummary class="text-danger" role="alert" />
				<input type="hidden" name="item.teacher" value="@item.teacher" />
				<input type="hidden" name="item.discipline" value="@item.discipline" />

				<button type="submit" class="btn btn-primary">Save</button>
			</EditForm>
		</div>
	</div>
}

<div>
	<a href="/teacher-disciplines">Back to List</a>
</div>

@code {
	[SupplyParameterFromQuery]
	private int teacher { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;

	[SupplyParameterFromForm]
	private TeacherDisciplineRelation? item { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.TeachersDisciplinesRelation
			.Include(x => x.Teacher)
			.Include(x => x.Discipline)
			.FirstOrDefaultAsync(m => m.teacher == teacher && m.discipline == discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task UpdateTeacherDisciplineRelation()
	{
		using var context = DbFactory.CreateDbContext();
		context.Attach(item!).State = EntityState.Modified;

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateConcurrencyException)
		{
			if (!TeacherDisciplineRelationExists())
			{
				NavigationManager.NavigateTo("notfound");
			}
			else
			{
				throw;
			}
		}

		NavigationManager.NavigateTo("/teacher-disciplines");
	}

	private bool TeacherDisciplineRelationExists()
	{
		using var context = DbFactory.CreateDbContext();
		return context.TeachersDisciplinesRelation.Any(e => e.teacher == teacher && e.discipline == discipline);
	}
}
