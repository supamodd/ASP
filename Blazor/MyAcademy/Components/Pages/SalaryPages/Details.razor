@page "/salary/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<h2>Salary</h2>
<hr />
@if (payment is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">payment_id</dt>
		<dd class="col-sm-10">@payment.payment_id</dd>
		<dt class="col-sm-2">teacher</dt>
		<dd class="col-sm-10">@($"{payment.Teacher?.last_name} ({payment.teacher})")</dd>
		<dt class="col-sm-2">accrued</dt>
		<dd class="col-sm-10">@payment.accrued</dd>
		<dt class="col-sm-2">received</dt>
		<dd class="col-sm-10">@payment.received</dd>
	</dl>

}

<div>
	<a href="@($"/salary/edit?payment_id={payment.payment_id}")">Edit</a> |
	<a href="/salary">Back to List</a>
</div>

@code {
	private Salary? payment;

	[SupplyParameterFromQuery]
	private long payment_id { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		payment ??= await context.Salary
			.Include(x => x.Teacher)
			.FirstOrDefaultAsync(m => m.payment_id == payment_id);

		if (payment is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}
}
