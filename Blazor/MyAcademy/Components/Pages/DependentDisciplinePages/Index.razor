@page "/dependent-disciplines"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Dependent Disciplines</PageTitle>

<h1>Dependent Disciplines</h1>

<div class="controls">
	<p>
		<a href="dependent-disciplines/create" class="btn btn-primary">Create New</a>
	</p>
	<form action="/dependent-disciplines" class="search-form">
		<input type="search" name="nameFilter" value="@NameFilter" placeholder="Search by Discipline, Dependent" />
		<input type="submit" value="Search" class="btn btn-primary" />
		<a href="dependent-disciplines" class="btn btn-secondary">Reset</a>
	</form>
	<div>
		<label for="items-per-page">Rows: </label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="13">13</option>
		</select>
	</div>
</div>

<div class="filters">
	<span class="filter-title">Filters:</span>
		<label class="filter-item">discipline:
			<select @bind="disciplineFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Disciplines)
				{
					<option value="@o.discipline_id">@o.discipline_name</option>
				}
			</select>
		</label>
		<label class="filter-item">dependent_discipline:
			<select @bind="dependent_disciplineFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Disciplines)
				{
					<option value="@o.discipline_id">@o.discipline_name</option>
				}
			</select>
		</label>
	<a href="dependent-disciplines" class="btn btn-secondary btn-sm">Reset</a>
</div>

<div class="grid-container">
	<QuickGrid Class="table" Items="FilteredDependentDisciplines" Pagination="pagination">
		<TemplateColumn Context="item" Title="discipline" Sortable="true" SortBy="@SortByDiscipline">
			<span>@item.Discipline?.discipline_name</span>
		</TemplateColumn>
		<TemplateColumn Context="item" Title="dependent_discipline" Sortable="true" SortBy="@SortByDependent">
			<span>@item.Dependent?.discipline_name</span>
		</TemplateColumn>
		<TemplateColumn Context="item" Title="actions">
			<a href="@($"dependent-disciplines/edit?discipline={item.discipline}&dependent_discipline={item.dependent_discipline}")">Edit</a> |
			<a href="@($"dependent-disciplines/details?discipline={item.discipline}&dependent_discipline={item.dependent_discipline}")">Details</a> |
			<a href="@($"dependent-disciplines/delete?discipline={item.discipline}&dependent_discipline={item.dependent_discipline}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

<Paginator State="pagination" />

@code {
	private MyAcademyContext context = default!;
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	// Поисковая строка приходит из адреса страницы: /dependent-disciplines?nameFilter=...
	[SupplyParameterFromQuery]
	string? NameFilter { get; set; }

	// Пустой фильтр = показываем все записи.
	// Регистр не важен: на SQL Server сравнение идёт по сортировке БД (CI).
	private string Filter => NameFilter ?? string.Empty;

	private int disciplineFilter { get; set; }
	private int dependent_disciplineFilter { get; set; }

	IQueryable<DependentDiscipline> FilteredDependentDisciplines =>
		BuildQuery();

	private IQueryable<DependentDiscipline> BuildQuery()
	{
		IQueryable<DependentDiscipline> q = context.DependentDisciplines
			.Include(x => x.Discipline)
			.Include(x => x.Dependent);

		var f = Filter;
		if (!string.IsNullOrEmpty(f))
		{
			q = q.Where(x =>
				x.Discipline != null && (x.Discipline.discipline_name ?? string.Empty).Contains(f) ||
				x.Dependent != null && (x.Dependent.discipline_name ?? string.Empty).Contains(f));
		}

		if (disciplineFilter != 0)
		{
			q = q.Where(x => x.discipline == disciplineFilter);
		}

		if (dependent_disciplineFilter != 0)
		{
			q = q.Where(x => x.dependent_discipline == dependent_disciplineFilter);
		}

		return q;
	}

	// Сортировка по связанным полям: TemplateColumn не поддерживает Property,
	// поэтому передаём GridSort.ByAscending(...)
	private GridSort<DependentDiscipline> SortByDiscipline { get; } =
		GridSort<DependentDiscipline>.ByAscending(x => x.Discipline!.discipline_name);

	private GridSort<DependentDiscipline> SortByDependent { get; } =
		GridSort<DependentDiscipline>.ByAscending(x => x.Dependent!.discipline_name);

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
