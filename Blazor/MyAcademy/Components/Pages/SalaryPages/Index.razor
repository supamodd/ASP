@page "/salary"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Salary</PageTitle>

<h1>Salary</h1>

<div class="controls">
	<p>
		<a href="salary/create" class="btn btn-primary">Create New</a>
	</p>
	<form action="/salary" class="search-form">
		<input type="search" name="nameFilter" value="@NameFilter" placeholder="Search by Teacher" />
		<input type="submit" value="Search" class="btn btn-primary" />
		<a href="salary" class="btn btn-secondary">Reset</a>
	</form>
	<div>
		<label for="items-per-page">Rows: </label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="13">13</option>
		</select>
	</div>
</div>

<div class="filters">
	<span class="filter-title">Filters:</span>
		<label class="filter-item">teacher:
			<select @bind="teacherFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Teachers)
				{
					<option value="@o.teacher_id">@o.last_name</option>
				}
			</select>
		</label>
		<label class="filter-item">received:
			<select @bind="receivedFilter" class="form-select form-select-sm">
				<option value="">all</option>
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</label>
	<a href="salary" class="btn btn-secondary btn-sm">Reset</a>
</div>

<div class="grid-container">
	<QuickGrid Class="table" Items="FilteredSalary" Pagination="pagination">
		<PropertyColumn Property="payment => payment.payment_id" Sortable="true" />
		<TemplateColumn Context="payment" Title="teacher" Sortable="true" SortBy="@SortByTeacher">
			<span>@payment.Teacher?.last_name</span>
		</TemplateColumn>
		<PropertyColumn Property="payment => payment.accrued" Sortable="true" />
		<PropertyColumn Property="payment => payment.received" Sortable="true" />
		<TemplateColumn Context="payment" Title="actions">
			<a href="@($"salary/edit?payment_id={payment.payment_id}")">Edit</a> |
			<a href="@($"salary/details?payment_id={payment.payment_id}")">Details</a> |
			<a href="@($"salary/delete?payment_id={payment.payment_id}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

<Paginator State="pagination" />

@code {
	private MyAcademyContext context = default!;
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	// Поисковая строка приходит из адреса страницы: /salary?nameFilter=...
	[SupplyParameterFromQuery]
	string? NameFilter { get; set; }

	// Пустой фильтр = показываем все записи.
	// Регистр не важен: на SQL Server сравнение идёт по сортировке БД (CI).
	private string Filter => NameFilter ?? string.Empty;

	private int teacherFilter { get; set; }
	private bool? receivedFilter { get; set; }

	IQueryable<Salary> FilteredSalary =>
		BuildQuery();

	private IQueryable<Salary> BuildQuery()
	{
		IQueryable<Salary> q = context.Salary
			.Include(x => x.Teacher);

		var f = Filter;
		if (!string.IsNullOrEmpty(f))
		{
			q = q.Where(x =>
				x.Teacher != null && (x.Teacher.last_name ?? string.Empty).Contains(f));
		}

		if (teacherFilter != 0)
		{
			q = q.Where(x => x.teacher == teacherFilter);
		}

		if (receivedFilter is not null)
		{
			q = q.Where(x => x.received == receivedFilter);
		}

		return q;
	}

	// Сортировка по связанным полям: TemplateColumn не поддерживает Property,
	// поэтому передаём GridSort.ByAscending(...)
	private GridSort<Salary> SortByTeacher { get; } =
		GridSort<Salary>.ByAscending(x => x.Teacher!.last_name);

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
