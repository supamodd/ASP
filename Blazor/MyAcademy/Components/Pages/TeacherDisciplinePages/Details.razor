@page "/teacher-disciplines/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<h2>TeacherDisciplineRelation</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">teacher</dt>
		<dd class="col-sm-10">@($"{item.Teacher?.last_name} ({item.teacher})")</dd>
		<dt class="col-sm-2">discipline</dt>
		<dd class="col-sm-10">@($"{item.Discipline?.discipline_name} ({item.discipline})")</dd>
	</dl>

}

<div>
	<a href="@($"/teacher-disciplines/edit?teacher={item.teacher}&discipline={item.discipline}")">Edit</a> |
	<a href="/teacher-disciplines">Back to List</a>
</div>

@code {
	private TeacherDisciplineRelation? item;

	[SupplyParameterFromQuery]
	private int teacher { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.TeachersDisciplinesRelation
			.Include(x => x.Teacher)
			.Include(x => x.Discipline)
			.FirstOrDefaultAsync(m => m.teacher == teacher && m.discipline == discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}
}
