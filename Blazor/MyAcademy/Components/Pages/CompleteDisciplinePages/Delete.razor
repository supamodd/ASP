@page "/complete-disciplines/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>CompleteDiscipline</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">group</dt>
		<dd class="col-sm-10">@($"{item.Group?.group_name} ({item.group})")</dd>
		<dt class="col-sm-2">discipline</dt>
		<dd class="col-sm-10">@($"{item.Discipline?.discipline_name} ({item.discipline})")</dd>
	</dl>

	<EditForm method="post" Model="item" OnValidSubmit="DeleteCompleteDiscipline" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/complete-disciplines">Back to List</a>
	</EditForm>
}

@code {
	private CompleteDiscipline? item;

	[SupplyParameterFromQuery]
	private int group { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.CompleteDisciplines
			.Include(x => x.Group)
			.Include(x => x.Discipline)
			.FirstOrDefaultAsync(m => m.group == group && m.discipline == discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteCompleteDiscipline()
	{
		using var context = DbFactory.CreateDbContext();
		context.CompleteDisciplines.Remove(item!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/complete-disciplines/details?group={item.group}&discipline={item.discipline}");
			return;
		}

		NavigationManager.NavigateTo("/complete-disciplines");
	}
}
