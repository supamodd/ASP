@page "/required-disciplines/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<h2>RequiredDiscipline</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">discipline</dt>
		<dd class="col-sm-10">@($"{item.Discipline?.discipline_name} ({item.discipline})")</dd>
		<dt class="col-sm-2">required_discipline</dt>
		<dd class="col-sm-10">@($"{item.Required?.discipline_name} ({item.required_discipline})")</dd>
	</dl>

}

<div>
	<a href="@($"/required-disciplines/edit?discipline={item.discipline}&required_discipline={item.required_discipline}")">Edit</a> |
	<a href="/required-disciplines">Back to List</a>
</div>

@code {
	private RequiredDiscipline? item;

	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int required_discipline { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.RequiredDisciplines
			.Include(x => x.Discipline)
			.Include(x => x.Required)
			.FirstOrDefaultAsync(m => m.discipline == discipline && m.required_discipline == required_discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}
}
