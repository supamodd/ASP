@page "/holidays"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Holidays</PageTitle>

<h1>Holidays</h1>

<div class="controls">
	<p>
		<a href="holidays/create" class="btn btn-primary">Create New</a>
	</p>
	<form action="/holidays" class="search-form">
		<input type="search" name="nameFilter" value="@NameFilter" placeholder="Search by holiday_name" />
		<input type="submit" value="Search" class="btn btn-primary" />
		<a href="holidays" class="btn btn-secondary">Reset</a>
	</form>
	<div>
		<label for="items-per-page">Rows: </label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="13">13</option>
		</select>
	</div>
</div>


<div class="grid-container">
	<QuickGrid Class="table" Items="FilteredHolidays" Pagination="pagination">
		<PropertyColumn Property="holiday => holiday.holiday_id" Sortable="true" />
		<PropertyColumn Property="holiday => holiday.holiday_name" Sortable="true" />
		<PropertyColumn Property="holiday => holiday.duration" Sortable="true" />
		<PropertyColumn Property="holiday => holiday.month" Sortable="true" />
		<PropertyColumn Property="holiday => holiday.day" Sortable="true" />
		<TemplateColumn Context="holiday" Title="actions">
			<a href="@($"holidays/edit?holiday_id={holiday.holiday_id}")">Edit</a> |
			<a href="@($"holidays/details?holiday_id={holiday.holiday_id}")">Details</a> |
			<a href="@($"holidays/delete?holiday_id={holiday.holiday_id}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

<Paginator State="pagination" />

@code {
	private MyAcademyContext context = default!;
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	// Поисковая строка приходит из адреса страницы: /holidays?nameFilter=...
	[SupplyParameterFromQuery]
	string? NameFilter { get; set; }

	// Пустой фильтр = показываем все записи.
	// Регистр не важен: на SQL Server сравнение идёт по сортировке БД (CI).
	private string Filter => NameFilter ?? string.Empty;



	IQueryable<Holiday> FilteredHolidays =>
		BuildQuery();

	private IQueryable<Holiday> BuildQuery()
	{
		IQueryable<Holiday> q = context.Holidays
			;

		var f = Filter;
		if (!string.IsNullOrEmpty(f))
		{
			q = q.Where(x =>
				x.holiday_name.Contains(f));
		}

		return q;
	}

	// Сортировка по связанным полям: TemplateColumn не поддерживает Property,
	// поэтому передаём GridSort.ByAscending(...)

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
