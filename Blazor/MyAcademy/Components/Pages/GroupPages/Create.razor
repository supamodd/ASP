@page "/groups/create"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Group</h2>
<hr />
<div class="row">
	<div class="col-md-6">
		<EditForm method="post" Model="Group" OnValidSubmit="AddGroup" FormName="create" Enhance>
			<DataAnnotationsValidator />
			<ValidationSummary class="text-danger" role="alert" />
			<div class="mb-3">
				<span class="text-danger">*</span>
				<label for="group_id" class="form-label">group_id:</label>
				<InputNumber id="group_id" @bind-Value="Group.group_id" class="form-control" aria-required="true" />
				<ValidationMessage For="() => Group.group_id" class="text-danger" />
			</div>
			<div class="mb-3">
				<span class="text-danger">*</span>
				<label for="group_name" class="form-label">group_name:</label>
				<InputText id="group_name" @bind-Value="Group.group_name" class="form-control" aria-required="true" />
				<ValidationMessage For="() => Group.group_name" class="text-danger" />
			</div>
			<div class="mb-3">
				<span class="text-danger">*</span>
				<label for="direction" class="form-label">direction:</label>
				<InputSelect id="direction" @bind-Value="Group.direction" class="form-select">
					@using (MyAcademy.Data.MyAcademyContext context = DbFactory.CreateDbContext())
					{
						@foreach (var item in context.Directions)
						{
							<option value="@item.direction_id">@item.direction_name</option>
						}
					}
				</InputSelect>
				<ValidationMessage For="() => Group.direction" class="text-danger" />
			</div>
			@* Дни занятий: битовая маска (1-Пн, 2-Вт, 4-Ср, 8-Чт, 16-Пт, 32-Сб, 64-Вс) *@
			<Weekdays @bind-Mask="Group.weekdays" />
			<div class="mb-3">
				<label for="start_time" class="form-label">start_time:</label>
				<InputDate Type="InputDateType.Time" id="start_time" @bind-Value="Group.start_time" class="form-control" />
				<ValidationMessage For="() => Group.start_time" class="text-danger" />
			</div>
			<div class="mb-3">
				<label for="start_date" class="form-label">start_date:</label>
				<InputDate id="start_date" @bind-Value="Group.start_date" class="form-control" />
				<ValidationMessage For="() => Group.start_date" class="text-danger" />
			</div>
			<button type="submit" class="btn btn-primary">Create</button>
		</EditForm>
	</div>
</div>

<div>
	<a href="/groups">Back to List</a>
</div>

@code {
	[SupplyParameterFromForm]
	private Group Group { get; set; } = new();

	// To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
	private async Task AddGroup()
	{
		using var context = DbFactory.CreateDbContext();
		context.Groups.Add(Group);
		await context.SaveChangesAsync();
		NavigationManager.NavigateTo("/groups");
	}
}
