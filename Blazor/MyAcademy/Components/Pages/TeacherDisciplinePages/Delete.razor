@page "/teacher-disciplines/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>TeacherDisciplineRelation</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">teacher</dt>
		<dd class="col-sm-10">@($"{item.Teacher?.last_name} ({item.teacher})")</dd>
		<dt class="col-sm-2">discipline</dt>
		<dd class="col-sm-10">@($"{item.Discipline?.discipline_name} ({item.discipline})")</dd>
	</dl>

	<EditForm method="post" Model="item" OnValidSubmit="DeleteTeacherDisciplineRelation" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/teacher-disciplines">Back to List</a>
	</EditForm>
}

@code {
	private TeacherDisciplineRelation? item;

	[SupplyParameterFromQuery]
	private int teacher { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.TeachersDisciplinesRelation
			.Include(x => x.Teacher)
			.Include(x => x.Discipline)
			.FirstOrDefaultAsync(m => m.teacher == teacher && m.discipline == discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteTeacherDisciplineRelation()
	{
		using var context = DbFactory.CreateDbContext();
		context.TeachersDisciplinesRelation.Remove(item!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/teacher-disciplines/details?teacher={item.teacher}&discipline={item.discipline}");
			return;
		}

		NavigationManager.NavigateTo("/teacher-disciplines");
	}
}
