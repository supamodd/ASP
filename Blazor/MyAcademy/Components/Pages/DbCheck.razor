@page "/dbcheck"
@using System.Data
@using System.Data.Common
@using System.IO
@using System.Text
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>DB diagnostics</PageTitle>

<h1>Диагностика базы данных</h1>

<button type="button" class="btn btn-primary btn-sm mb-3" @onclick="SaveSchema">
    Сохранить схему в файл
</button>

@if (!string.IsNullOrEmpty(savedTo))
{
    <div class="alert alert-info">
        Файл сохранён: <code>@savedTo</code><br />
        Приложите его к сообщению — по нему я настрою модели.
    </div>
}
@if (!string.IsNullOrEmpty(saveError))
{
    <div class="alert alert-warning">@saveError</div>
}

<p><strong>Строка подключения:</strong> <code>@connectionString</code></p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">
        <h4>Подключиться не удалось</h4>
        <pre style="white-space:pre-wrap">@error</pre>
        <p class="mb-0">
            Проверьте: развёрнута ли БД <code>SPU_411_Import</code> в LocalDB
            (SSMS → Databases → Import Data-tier Application → указать
            <code>C:\SPU_411_Import\SPU_411_Import.bacpac</code>) и совпадает ли имя базы
            в <code>appsettings.json</code>.
        </p>
    </div>
}
else
{
    <div class="alert alert-success">Подключение установлено. @serverVersion</div>

    <h3>Базы данных на сервере</h3>
    @if (!string.IsNullOrEmpty(databasesError))
    {
        <p class="text-danger">@databasesError</p>
    }
    else
    {
        <ul>
            @foreach (var name in databases)
            {
                <li>@name @(name == currentDatabase ? " <-- текущая" : "")</li>
            }
        </ul>
    }

    <h3>Таблицы</h3>
    @if (!string.IsNullOrEmpty(tablesError))
    {
        <p class="text-danger">@tablesError</p>
    }
    else if (tables.Count == 0)
    {
        <p><em>В базе нет таблиц.</em></p>
    }
    else
    {
        <table class="table table-sm table-striped">
            <thead><tr><th>Схема</th><th>Таблица</th></tr></thead>
            <tbody>
                @foreach (var t in tables)
                {
                    <tr><td>@t.Item1</td><td>@t.Item2</td></tr>
                }
            </tbody>
        </table>
    }

    <h3>Колонки</h3>
    @if (!string.IsNullOrEmpty(columnsError))
    {
        <p class="text-danger">@columnsError</p>
    }
    else
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr><th>Таблица</th><th>Колонка</th><th>Тип</th><th>NULL</th><th>IDENTITY</th></tr>
            </thead>
            <tbody>
                @foreach (var c in columns)
                {
                    <tr>
                        <td>@c.Item1</td>
                        <td>@c.Item2</td>
                        <td>@c.Item3</td>
                        <td>@c.Item4</td>
                        <td>@c.Item5</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private string? connectionString;
    private string? serverVersion;
    private string? currentDatabase;
    private string? error;
    private string? databasesError;
    private string? tablesError;
    private string? columnsError;
    private string? savedTo;
    private string? saveError;
    private List<string> databases = new();
    private List<(string, string)> tables = new();
    private List<(string, string, string, string, string)> columns = new();

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        var conn = db.Database.GetDbConnection();
        connectionString = conn.ConnectionString;
        currentDatabase = conn.Database;

        try
        {
            await conn.OpenAsync();
            serverVersion = $"Сервер: {conn.ServerVersion}; база: {conn.Database}";

            try
            {
                databases = await QueryAsync(conn,
                    "SELECT name FROM sys.databases ORDER BY name",
                    r => r.GetString(0));
            }
            catch (Exception ex) { databasesError = ex.Message; }

            try
            {
                tables = await QueryAsync(conn,
                    "SELECT TABLE_SCHEMA, TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_TYPE = 'BASE TABLE' ORDER BY TABLE_NAME",
                    r => (r.GetString(0), r.GetString(1)));
            }
            catch (Exception ex) { tablesError = ex.Message; }

            try
            {
                columns = await QueryAsync(conn,
                    @"SELECT c.TABLE_NAME,
                             c.COLUMN_NAME,
                             c.DATA_TYPE,
                             c.IS_NULLABLE,
                             CONVERT(nvarchar(10), ISNULL(COLUMNPROPERTY(OBJECT_ID(c.TABLE_SCHEMA + '.' + c.TABLE_NAME), c.COLUMN_NAME, 'IsIdentity'), 0))
                      FROM INFORMATION_SCHEMA.COLUMNS c
                      ORDER BY c.TABLE_NAME, c.ORDINAL_POSITION",
                    r => (r.GetString(0), r.GetString(1), r.GetString(2), r.GetString(3), r.GetString(4)));
            }
            catch (Exception ex) { columnsError = ex.Message; }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            if (conn.State == ConnectionState.Open)
            {
                await conn.CloseAsync();
            }
        }
    }

    // Сохраняет схему в текстовый файл, чтобы не перепечатывать её вручную
    private void SaveSchema()
    {
        var lines = new List<string>
        {
            "=== MyAcademy: схема базы данных ===",
            $"Строка подключения: {connectionString}",
            $"Статус: {(string.IsNullOrEmpty(error) ? "подключено" : "ОШИБКА: " + error)}",
            "",
            "=== Таблицы ===",
            "TABLE_SCHEMA\tTABLE_NAME"
        };
        foreach (var t in tables)
        {
            lines.Add($"{t.Item1}\t{t.Item2}");
        }
        lines.Add("");
        lines.Add("=== Колонки ===");
        lines.Add("TABLE_NAME\tCOLUMN_NAME\tDATA_TYPE\tIS_NULLABLE\tIS_IDENTITY");
        foreach (var c in columns)
        {
            lines.Add($"{c.Item1}\t{c.Item2}\t{c.Item3}\t{c.Item4}\t{c.Item5}");
        }

        var candidates = new[]
        {
            Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory), "MyAcademy_schema.txt"),
            @"C:\SPU_411_Import\MyAcademy_schema.txt",
            Path.Combine(Path.GetTempPath(), "MyAcademy_schema.txt")
        };

        foreach (var path in candidates)
        {
            try
            {
                var dir = Path.GetDirectoryName(path);
                if (!string.IsNullOrEmpty(dir))
                {
                    Directory.CreateDirectory(dir);
                }
                File.WriteAllLines(path, lines, new UTF8Encoding(true));
                savedTo = path;
                saveError = null;
                return;
            }
            catch (Exception ex)
            {
                saveError = ex.Message;
            }
        }
    }

    private static async Task<List<T>> QueryAsync<T>(DbConnection conn, string sql, Func<DbDataReader, T> map)
    {
        var result = new List<T>();
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = sql;
        await using var reader = await cmd.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            result.Add(map(reader));
        }
        return result;
    }
}
