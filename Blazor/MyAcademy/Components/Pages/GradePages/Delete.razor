@page "/grades/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h2>Grade</h2>
<hr />
@if (grade is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<dl class="row">
		<dt class="col-sm-2">student</dt>
		<dd class="col-sm-10">@($"{grade.Student?.last_name} ({grade.student})")</dd>
		<dt class="col-sm-2">lesson</dt>
		<dd class="col-sm-10">@($"{grade.Lesson?.date} ({grade.lesson})")</dd>
		<dt class="col-sm-2">grade_1</dt>
		<dd class="col-sm-10">@grade.grade_1</dd>
		<dt class="col-sm-2">grade_2</dt>
		<dd class="col-sm-10">@grade.grade_2</dd>
	</dl>

	<EditForm method="post" Model="grade" OnValidSubmit="DeleteGrade" FormName="delete" Enhance>
		<button type="submit" class="btn btn-danger">Delete</button> |
		<a href="/grades">Back to List</a>
	</EditForm>
}

@code {
	private Grade? grade;

	[SupplyParameterFromQuery]
	private int student { get; set; } = default!;
	[SupplyParameterFromQuery]
	private long lesson { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		grade ??= await context.Grades
			.Include(x => x.Student)
			.Include(x => x.Lesson)
			.Include(x => x.Lesson).ThenInclude(y => y.Group)
			.Include(x => x.Lesson).ThenInclude(y => y.Discipline)
			.Include(x => x.Lesson).ThenInclude(y => y.Teacher)
			.FirstOrDefaultAsync(m => m.student == student && m.lesson == lesson);

		if (grade is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task DeleteGrade()
	{
		using var context = DbFactory.CreateDbContext();
		context.Grades.Remove(grade!);

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateException)
		{
			// Запись используется в других таблицах (есть связанные строки)
			NavigationManager.NavigateTo($"/grades/details?student={grade.student}&lesson={grade.lesson}");
			return;
		}

		NavigationManager.NavigateTo("/grades");
	}
}
