@page "/attendance"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Attendance</PageTitle>

<h1>Attendance</h1>

<div class="controls">
	<p>
		<a href="attendance/create" class="btn btn-primary">Create New</a>
	</p>
	<form action="/attendance" class="search-form">
		<input type="search" name="nameFilter" value="@NameFilter" placeholder="Search by Student, Lesson" />
		<input type="submit" value="Search" class="btn btn-primary" />
		<a href="attendance" class="btn btn-secondary">Reset</a>
	</form>
	<div>
		<label for="items-per-page">Rows: </label>
		<select @bind="pagination.ItemsPerPage" id="items-per-page">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="8">8</option>
			<option value="13">13</option>
		</select>
	</div>
</div>

<div class="filters">
	<span class="filter-title">Filters:</span>
		<label class="filter-item">student:
			<select @bind="studentFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Students)
				{
					<option value="@o.stud_id">@o.last_name</option>
				}
			</select>
		</label>
		<label class="filter-item">lesson:
			<select @bind="lessonFilter" class="form-select form-select-sm">
				<option value="0">all</option>
				@foreach (var o in context.Schedule)
				{
					<option value="@o.lesson_id">@o.date</option>
				}
			</select>
		</label>
		<label class="filter-item">present:
			<select @bind="presentFilter" class="form-select form-select-sm">
				<option value="">all</option>
				<option value="true">yes</option>
				<option value="false">no</option>
			</select>
		</label>
	<a href="attendance" class="btn btn-secondary btn-sm">Reset</a>
</div>

<div class="grid-container">
	<QuickGrid Class="table" Items="FilteredAttendance" Pagination="pagination">
		<TemplateColumn Context="item" Title="student" Sortable="true" SortBy="@SortByStudent">
			<span>@item.Student?.last_name</span>
		</TemplateColumn>
		<TemplateColumn Context="item" Title="lesson" Sortable="true" SortBy="@SortByLesson">
			<span>@item.Lesson?.date</span>
		</TemplateColumn>
		<PropertyColumn Property="item => item.present" Sortable="true" />
		<TemplateColumn Context="item" Title="actions">
			<a href="@($"attendance/edit?student={item.student}&lesson={item.lesson}")">Edit</a> |
			<a href="@($"attendance/details?student={item.student}&lesson={item.lesson}")">Details</a> |
			<a href="@($"attendance/delete?student={item.student}&lesson={item.lesson}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

<Paginator State="pagination" />

@code {
	private MyAcademyContext context = default!;
	PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

	// Поисковая строка приходит из адреса страницы: /attendance?nameFilter=...
	[SupplyParameterFromQuery]
	string? NameFilter { get; set; }

	// Пустой фильтр = показываем все записи.
	// Регистр не важен: на SQL Server сравнение идёт по сортировке БД (CI).
	private string Filter => NameFilter ?? string.Empty;

	private int studentFilter { get; set; }
	private long lessonFilter { get; set; }
	private bool? presentFilter { get; set; }

	IQueryable<Attendance> FilteredAttendance =>
		BuildQuery();

	private IQueryable<Attendance> BuildQuery()
	{
		IQueryable<Attendance> q = context.Attendance
			.Include(x => x.Student)
			.Include(x => x.Lesson)
			.Include(x => x.Lesson).ThenInclude(y => y.Group)
			.Include(x => x.Lesson).ThenInclude(y => y.Discipline);

		var f = Filter;
		if (!string.IsNullOrEmpty(f))
		{
			q = q.Where(x =>
				x.Student != null && x.Student.last_name.Contains(f) ||
				x.Student != null && (x.Student.first_name ?? string.Empty).Contains(f) ||
				x.Lesson != null && x.Lesson.Group != null && x.Lesson.Group.group_name.Contains(f));
		}

		if (studentFilter != 0)
		{
			q = q.Where(x => x.student == studentFilter);
		}

		if (lessonFilter != 0)
		{
			q = q.Where(x => x.lesson == lessonFilter);
		}

		if (presentFilter is not null)
		{
			q = q.Where(x => x.present == presentFilter);
		}

		return q;
	}

	// Сортировка по связанным полям: TemplateColumn не поддерживает Property,
	// поэтому передаём GridSort.ByAscending(...)
	private GridSort<Attendance> SortByStudent { get; } =
		GridSort<Attendance>.ByAscending(x => x.Student!.last_name);

	private GridSort<Attendance> SortByLesson { get; } =
		GridSort<Attendance>.ByAscending(x => x.Lesson!.date);

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
