@page "/discipline-directions/edit"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>DisciplineDirectionRelation</h2>
<hr />
@if (item is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<div class="row">
		<div class="col-md-6">
			<EditForm method="post" Model="item" OnValidSubmit="UpdateDisciplineDirectionRelation" FormName="edit" Enhance>
				<DataAnnotationsValidator />
				<ValidationSummary class="text-danger" role="alert" />
				<input type="hidden" name="item.direction" value="@item.direction" />
				<input type="hidden" name="item.discipline" value="@item.discipline" />

				<button type="submit" class="btn btn-primary">Save</button>
			</EditForm>
		</div>
	</div>
}

<div>
	<a href="/discipline-directions">Back to List</a>
</div>

@code {
	[SupplyParameterFromQuery]
	private int direction { get; set; } = default!;
	[SupplyParameterFromQuery]
	private int discipline { get; set; } = default!;

	[SupplyParameterFromForm]
	private DisciplineDirectionRelation? item { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		item ??= await context.DisciplinesDirectionsRelation
			.Include(x => x.Direction)
			.Include(x => x.Discipline)
			.FirstOrDefaultAsync(m => m.direction == direction && m.discipline == discipline);

		if (item is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}

	private async Task UpdateDisciplineDirectionRelation()
	{
		using var context = DbFactory.CreateDbContext();
		context.Attach(item!).State = EntityState.Modified;

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateConcurrencyException)
		{
			if (!DisciplineDirectionRelationExists())
			{
				NavigationManager.NavigateTo("notfound");
			}
			else
			{
				throw;
			}
		}

		NavigationManager.NavigateTo("/discipline-directions");
	}

	private bool DisciplineDirectionRelationExists()
	{
		using var context = DbFactory.CreateDbContext();
		return context.DisciplinesDirectionsRelation.Any(e => e.direction == direction && e.discipline == discipline);
	}
}
